---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, stats } from '../../data/site';
import { specialties, sections, news } from '../../data/content';
const copy = t.kz;
---
<BaseLayout lang="kz" title="Басты бет">
  <section class="hero section"><div class="hero-grid container"><div><p class="eyebrow">Ресми цифрлық платформа</p><h1>{copy.heroTitle}</h1><p class="lead">{copy.heroText}</p><div class="mt-6 flex gap-4"><a class="btn btn-primary" href="/kz/admissions/">{copy.apply}</a><a class="btn btn-secondary" href="/kz/specialties/">{copy.choose}</a></div></div><div class="hero-visual glass"><img src="https://images.unsplash.com/photo-1576765608535-5f04d1e3f289?auto=format&fit=crop&w=1200&q=85" alt="Медициналық білім" /><div class="hero-badge"><b>IQAA 2021–2026</b><p>Білім беру бағдарламаларын аккредиттеу</p></div></div></div></section>
  <section class="stats section container">{stats.map(s => <div class="stat glass card"><b>{s[0]}</b><span>{s[1]}</span></div>)}</section>
  <section class="section container"><p class="eyebrow">Бөлімдер</p><h2 class="section-title">Колледж порталы</h2><div class="grid-auto">{sections.map(s => <a class="card" href={`/kz/${s[0]}/`}><b>{s[1]}</b><p>{s[2]}</p></a>)}</div></section>
  <section class="section container"><p class="eyebrow">Бағдарламалар</p><h2 class="section-title">{copy.specialties}</h2><div class="grid-auto">{specialties.map(sp => <div class="card"><span class="badge">{sp[4]}</span><h3>{sp[2]}</h3><p>{sp[1]} · {sp[3]}</p></div>)}</div></section>
  <section class="section container"><p class="eyebrow">Жаңалықтар</p><h2 class="section-title">Соңғы материалдар</h2><div class="grid-auto">{news.map(n => <div class="card"><span class="badge">{n[1]}</span><h3>{n[2]}</h3><p>Материал кейін толық жаңалық бетіне кеңейтіледі.</p></div>)}</div></section>
</BaseLayout>