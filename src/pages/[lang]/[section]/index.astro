---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageShell from '../../../components/PageShell.astro';
import { languages, t } from '../../../data/site';

const sectionKeys = ['about','specialties','admissions','students','practice','documents','news','contacts'];

export function getStaticPaths() {
  return languages.flatMap((lang) => {
    const copy = t[lang];
    return sectionKeys.map((section) => ({
      params: { lang, section },
      props: { lang, section, title: copy[section] }
    }));
  });
}

const { lang, section, title } = Astro.props;
---
<BaseLayout lang={lang} title={title}>
  <PageShell lang={lang} kind={section} title={title} />
</BaseLayout>
